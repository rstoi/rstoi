# Domínio corporativo exigido (verificação REAL do login acontece aqui).
ALLOWED_DOMAIN=setup.com.br

# Projeto Firebase/GCP usado para verificar os ID tokens.
GOOGLE_CLOUD_PROJECT=

# Em Cloud Run a credencial vem da service account (ADC). Localmente, aponte:
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/sa.json

# Porta (Cloud Run injeta PORT automaticamente).
PORT=8080

# Shell e comando do Claude CLI das sessões pty.
SHELL_CMD=/bin/bash
CLAUDE_CMD=claude

# RBAC: grupos/claims autorizados a abrir Terminal e Claude CLI (vírgula).
# Espelha o guardrail WA_AGENT_GROUPS do projeto. Vazio => ninguém (deny).
OPERATOR_ROLES=operador,admin
