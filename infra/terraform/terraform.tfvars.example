# Copie para terraform.tfvars e ajuste.
project_id        = "meu-projeto-gcp"
region            = "us-central1"
zone              = "us-central1-a"

domain            = "baita.ac"
iap_support_email = "renato@baita.ac"

# Hostnames: deixe vazios para derivar do IP fixo via nip.io (sem precisar de
# acesso ao DNS do baita.ac, que está no Cloudflare). O login continua restrito
# a @baita.ac pelo IAP, independentemente do nome da URL.
app_hostname        = ""
control_hostname    = ""
wildcard_dns_suffix = "nip.io"   # ou "sslip.io"
# Se um dia você controlar um domínio, basta preencher:
# app_hostname     = "app.exemplo.com"
# control_hostname = "claude.exemplo.com"

machine_type          = "e2-standard-4"
disk_size_gb          = 80
idle_shutdown_minutes = 30

# Opcional: deixe vazio e popule o Secret Manager manualmente (recomendado).
# anthropic_api_key = "sk-ant-..."
