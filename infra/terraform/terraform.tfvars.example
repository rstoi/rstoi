# Copie para terraform.tfvars e ajuste.
project_id        = "meu-projeto-gcp"
region            = "us-central1"
zone              = "us-central1-a"

domain            = "baita.ac"
iap_support_email = "renato@baita.ac"

# ── Hostnames ────────────────────────────────────────────────────────────────
# OPÇÃO 1 (padrão): nip.io derivado do IP fixo — sem precisar de acesso a DNS.
app_hostname        = ""
control_hostname    = ""
wildcard_dns_suffix = "nip.io"   # ou "sslip.io"

# OPÇÃO 2: domínio próprio baita.one (descomente e ajuste).
# app_hostname     = "app.baita.one"
# control_hostname = "claude.baita.one"
#   2a) DNS no Cloud DNS -> automatiza os registros A:
# manage_dns       = true
# dns_managed_zone = "baita-one"          # nome da managed zone
#   2b) DNS em outro registrador -> deixe manage_dns=false e crie 2 registros A
#       (app./claude.baita.one) apontando para o output load_balancer_ip.

# O login continua restrito a @baita.ac pelo IAP, independentemente do domínio
# da URL. Para logar com @baita.one, troque: domain = "baita.one".

machine_type          = "e2-standard-4"
disk_size_gb          = 80
idle_shutdown_minutes = 30

# Opcional: deixe vazio e popule o Secret Manager manualmente (recomendado).
# anthropic_api_key = "sk-ant-..."
