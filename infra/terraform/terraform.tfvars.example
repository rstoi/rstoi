# Copie para terraform.tfvars e ajuste.
project_id        = "meu-projeto-gcp"
region            = "us-central1"
zone              = "us-central1-a"

domain            = "baita.ac"
iap_support_email = "renato@baita.ac"

# ── Hostnames ────────────────────────────────────────────────────────────────
# Domínio próprio baita.one (DNS no Porkbun, via API).
app_hostname     = "app.baita.one"
control_hostname = "claude.baita.one"
manage_dns       = false   # DNS é feito pelo Porkbun (make porkbun), não pelo Cloud DNS

# Os registros A são criados por infra/scripts/porkbun-dns.sh com as chaves:
#   export PORKBUN_API_KEY=pk1_...
#   export PORKBUN_SECRET_API_KEY=sk1_...
# e então:  make porkbun   (depois do apply)

# ALTERNATIVA sem domínio: deixe os hostnames vazios para usar nip.io.
# app_hostname = ""
# control_hostname = ""
# wildcard_dns_suffix = "nip.io"

# Login restrito a @baita.ac pelo IAP, independente da URL.
# Para logar com @baita.one, troque: domain = "baita.one".

machine_type          = "e2-standard-4"
disk_size_gb          = 80
idle_shutdown_minutes = 30

# Opcional: deixe vazio e popule o Secret Manager manualmente (recomendado).
# anthropic_api_key = "sk-ant-..."
