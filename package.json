{
  "name": "whatsapp-business-mcp",
  "version": "1.0.0",
  "description": "WhatsApp Business MCP server for Claude Code agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "whatsapp-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "mock": "tsx src/meta-mock.ts",
    "computer-use": "bash src/computer-use/start.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:chrome": "bash scripts/install-chrome.sh",
    "connect": "tsx scripts/wa-connect.ts",
    "personal": "WA_ADAPTER=playwright tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.3",
    "playwright": "^1.44.0",
    "qrcode": "^1.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}
