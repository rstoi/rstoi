# Adapter: cloud-api | baileys
WA_ADAPTER=baileys

# ── Meta WhatsApp Cloud API (production) ─────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_WEBHOOK_VERIFY_TOKEN=
WA_WEBHOOK_SECRET=

# ── Baileys / WhatsApp Web (dev / personal) ───────────────────────────────────
WA_SESSION_PATH=./data/session

# ── Server ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=3000
MCP_TRANSPORT=stdio

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/whatsapp.db
LOG_LEVEL=info

# ── Guardrail ─────────────────────────────────────────────────────────────────
# Chats/grupos que os agentes NÃO podem monitorar nem interagir (nomes ou JIDs,
# separados por vírgula, sem distinção de maiúsc./minúsc.).
WA_BLOCKED_GROUPS=financasfacil

# ── Agente /setup (npm run agent) — controles de segurança ────────────────────
# /setup executa shell arbitrário no host. Autorização (deny por padrão):
#  - membros de um GRUPO escopado abaixo podem disparar /setup, OU
#  - um remetente explicitamente autorizado.
# Se ambos ficarem vazios => NINGUÉM é autorizado (nunca RCE aberta).
#
# Grupos confiáveis onde o agente aceita /setup (nomes ou JIDs, vírgula).
WA_AGENT_GROUPS=financeiro setup,projetos setup
# (Opcional) restringe ainda mais por número, mesmo dentro dos grupos.
# Vazio = qualquer membro dos grupos acima está autorizado.
WA_AGENT_ALLOWED_SENDERS=

# ── Agente X / Twitter (@rtoi) — npm run agent trata /x ───────────────────────
# Acesso ao X por automação de navegador (Playwright). Login inicial manual:
# `npm run x-connect` (sessão salva em X_SESSION_DIR; sem QR no X).
X_SESSION_DIR=./data/x-session       # storageState do login do X
X_HEADLESS=true                      # x-connect força false p/ login manual
X_USERNAME=rtoi                      # handle sem @ (verifica login / lê perfil)
X_CHROMIUM_PATH=                     # caminho do Chromium (auto-detecta se vazio)
# Autonomia: off (sempre pede aprovação) | all (publica tudo) | CSV de tipos
# (tweet,thread,reply,quote) que publicam sem aprovação.
X_AUTO_POST=off
X_APPROVAL_TIMEOUT_MS=1800000        # 30 min p/ aprovar um rascunho
X_DRY_RUN=false                      # true = não publica de verdade (testes)
# Autorização do /x (deny por padrão, igual ao /setup) — mais restrita:
X_AGENT_GROUPS=
X_AGENT_ALLOWED_SENDERS=
