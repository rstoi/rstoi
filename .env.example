# Adapter: cloud-api | baileys
WA_ADAPTER=baileys

# ── Meta WhatsApp Cloud API (production) ─────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_WEBHOOK_VERIFY_TOKEN=
WA_WEBHOOK_SECRET=

# ── Baileys / WhatsApp Web (dev / personal) ───────────────────────────────────
WA_SESSION_PATH=./data/session

# ── Server ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=3000
MCP_TRANSPORT=stdio

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/whatsapp.db
LOG_LEVEL=info

# ── Guardrail ─────────────────────────────────────────────────────────────────
# Chats/grupos que os agentes NÃO podem monitorar nem interagir (nomes ou JIDs,
# separados por vírgula, sem distinção de maiúsc./minúsc.).
WA_BLOCKED_GROUPS=financasfacil

# ── Agente /setup (npm run agent) — controles de segurança ────────────────────
# /setup executa shell arbitrário no host. Autorização (deny por padrão):
#  - membros de um GRUPO escopado abaixo podem disparar /setup, OU
#  - um remetente explicitamente autorizado.
# Se ambos ficarem vazios => NINGUÉM é autorizado (nunca RCE aberta).
#
# Grupos confiáveis onde o agente aceita /setup (nomes ou JIDs, vírgula).
WA_AGENT_GROUPS=financeiro setup,projetos setup
# (Opcional) restringe ainda mais por número, mesmo dentro dos grupos.
# Vazio = qualquer membro dos grupos acima está autorizado.
WA_AGENT_ALLOWED_SENDERS=

# ── Agente Banco BMP (AntecipaFácil) — npm run bmp:sync | bmp:daemon ──────────
# Extrai o extrato da conta BMP no webapp AntecipaFácil e registra as
# movimentações em SQLite (BMP_DB_PATH). Ver docs/BANCO-BMP.md.
#
# CONEXÃO (abordagem do blueprint):
#   cdp    = ANEXA-SE a um Chrome já aberto e AUTENTICADO (não digita senha) (PADRÃO)
#   launch = abre um Chromium próprio (usa sessão salva OAuth ou login por senha)
BMP_CONNECT_MODE=cdp
# Endpoint de remote-debugging do Chrome já logado (modo cdp). Abra-o assim:
#   google-chrome --remote-debugging-port=9222 --user-data-dir=$HOME/.bmp-chrome
BMP_CDP_URL=http://localhost:9222
#
# Fonte do extrato: escrow (Conta consignada / Banco Money Plus, PADRÃO) ou generico.
BMP_EXTRATO_FONTE=escrow
BMP_ESCROW_URL=https://dash.antecipafacil.net.br/escrow-account
# Período do extrato (ISO YYYY-MM-DD); vazio = o que a tela já mostra.
BMP_PERIODO_INICIO=
BMP_PERIODO_FIM=
BMP_MAX_PAGINAS=50
#
# Autenticação (apenas modo launch): o painel usa OAuth (Google/Microsoft).
#   session  = login interativo uma vez + reuso da sessão salva (PADRÃO do launch)
#   password = formulário usuário/senha (legado; preencha BMP_AF_USER/PASSWORD)
BMP_AUTH_MODE=session
# Modo password apenas (SEGREDOS — no environment, não aqui):
BMP_AF_USER=
BMP_AF_PASSWORD=
# Tempo de espera (ms) pelo login interativo quando BMP_HEADLESS=false (padrão 5min).
BMP_LOGIN_WAIT_MS=300000
# URL do painel e (opcional) URL direta do extrato (modo generico).
BMP_AF_URL=https://dash.antecipafacil.net.br
BMP_AF_EXTRATO_URL=
# Rótulo da conta gravado em cada movimentação.
BMP_CONTA=BMP conta consignada (Banco Money Plus)
# Armazenamento e sessão do navegador (persistidos em ./data, fora do Git).
BMP_DB_PATH=./data/bmp.db
BMP_SESSION_DIR=./data/bmp-session
BMP_HEADLESS=true
# BMP_CHROMIUM_PATH=/opt/chromium/chrome-linux/chrome
#
# Agendamento diário (padrão 01:00 horário de Brasília).
BMP_RUN_HOUR=1
BMP_RUN_MINUTE=0
BMP_TIMEZONE=America/Sao_Paulo
#
# Ajuste fino da UI do AntecipaFácil (inspecione a página real e sobreponha):
# Seletores CSS (aceitam vírgula como lista de candidatos).
# BMP_SEL_USER=
# BMP_SEL_PASSWORD=
# BMP_SEL_SUBMIT=
# BMP_SEL_LOGGED_IN=
# BMP_SEL_ROW=
# BMP_SEL_CELL=
# BMP_SEL_PERIODO_INICIO=
# BMP_SEL_PERIODO_FIM=
# BMP_SEL_BUSCAR=
# BMP_SEL_PROXIMA=
# Índices (base 0) das colunas na linha do extrato.
# BMP_COL_DATA=0
# BMP_COL_DESCRICAO=1
# BMP_COL_DOCUMENTO=2
# BMP_COL_VALOR=3
# BMP_COL_SALDO=4
