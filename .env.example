# Adapter: cloud-api | baileys
WA_ADAPTER=baileys

# ── Meta WhatsApp Cloud API (production) ─────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_WEBHOOK_VERIFY_TOKEN=
WA_WEBHOOK_SECRET=

# ── Baileys / WhatsApp Web (dev / personal) ───────────────────────────────────
WA_SESSION_PATH=./data/session

# ── Server ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=3000
MCP_TRANSPORT=stdio

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/whatsapp.db
LOG_LEVEL=info
