# Adapter: cloud-api | baileys
WA_ADAPTER=baileys

# ── Meta WhatsApp Cloud API (production) ─────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_WEBHOOK_VERIFY_TOKEN=
WA_WEBHOOK_SECRET=

# ── Baileys / WhatsApp Web (dev / personal) ───────────────────────────────────
WA_SESSION_PATH=./data/session

# ── Server ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=3000
MCP_TRANSPORT=stdio

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/whatsapp.db
LOG_LEVEL=info

# ── Guardrail ─────────────────────────────────────────────────────────────────
# Chats/grupos que os agentes NÃO podem monitorar nem interagir (nomes ou JIDs,
# separados por vírgula, sem distinção de maiúsc./minúsc.).
WA_BLOCKED_GROUPS=financasfacil

# ── Assistente de Infraestrutura de TI (npm run it-assistant) ─────────────────
# Painel web de monitoramento de rede doméstica/videoconferência, com login
# Google restrito ao domínio corporativo.
# Client ID OAuth 2.0 do Google Cloud Console (tipo "Web application").
# Authorized redirect/origin: a URL pública do painel (ex.: https://it.baita.ac).
GOOGLE_CLIENT_ID=
# Segredo usado para assinar o cookie de sessão (JWT). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Domínio Google Workspace autorizado a logar (checa o claim `hd` e o sufixo do e-mail).
IT_ASSISTANT_ALLOWED_DOMAIN=baita.ac
# E-mails (separados por vírgula) que viram admin no primeiro login (podem
# remover/gerenciar dispositivos de qualquer pessoa).
IT_ASSISTANT_ADMINS=
IT_ASSISTANT_PORT=4200
IT_ASSISTANT_DB_PATH=./data/it-assistant.db

# ── Agente /setup (npm run agent) — controles de segurança ────────────────────
# /setup executa shell arbitrário no host. Autorização (deny por padrão):
#  - membros de um GRUPO escopado abaixo podem disparar /setup, OU
#  - um remetente explicitamente autorizado.
# Se ambos ficarem vazios => NINGUÉM é autorizado (nunca RCE aberta).
#
# Grupos confiáveis onde o agente aceita /setup (nomes ou JIDs, vírgula).
WA_AGENT_GROUPS=financeiro setup,projetos setup
# (Opcional) restringe ainda mais por número, mesmo dentro dos grupos.
# Vazio = qualquer membro dos grupos acima está autorizado.
WA_AGENT_ALLOWED_SENDERS=
